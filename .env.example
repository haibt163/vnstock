# VNStock data provider
# auto (default) = VPS public board → Yahoo delayed → demo
# vps            = same cascade (VPS still primary)
# mock           = deterministic demo fixture
# ssi            = SSI FastConnect when credentials exist, otherwise demo
MARKET_DATA_PROVIDER=auto

# Optional SSI FastConnect Data (official, credentialed)
# Create keys in SSI iBoard. Never commit real values.
# FastConnect is EOD-oriented and is not the live quote source in this build.
SSI_CONSUMER_ID=
SSI_CONSUMER_SECRET=
